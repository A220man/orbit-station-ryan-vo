# Application Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DATABASE_URL=sqlite:///./orbit_station.db

# Authentication (OIDC / Keycloak)
# In production, set DEMO_MODE=false and provide Keycloak parameters.
DEMO_MODE=true
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/orbit-station
OIDC_CLIENT_ID=orbit-station-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=orbit-station-app

# LLM Advisory Service (Optional - system functions fully offline without keys)
# LLM_API_KEY is the only secret variable for LLM operations.
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
